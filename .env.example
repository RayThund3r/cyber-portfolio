# ───────── Server (never prefix with NEXT_PUBLIC_) ─────────
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO=raytbolt@gmail.com
# After verifying a domain in Resend: real sender. Also enables customer confirmation + status emails.
# CONTACT_FROM="Your Business <hello@yourdomain.com>"
# CONTACT_BACKUP_TO=

# Admin dashboard (/admin). REQUIRED to use it. 10+ characters; use a long random passphrase.
ADMIN_PASSWORD=
# 2FA (strongly recommended): run `node scripts/make-totp-secret.mjs`, paste the secret here and add it to an
# authenticator app (Google Authenticator / Authy / Microsoft Authenticator). Login then needs password + 6-digit code.
# ADMIN_TOTP_SECRET=
# Only these IPs can even reach the admin (comma separated). Leave empty if your IP changes (mobile data).
# ADMIN_ALLOWED_IPS=41.210.0.1
# Optional but recommended: separate random string used to sign the admin cookie
# ADMIN_SESSION_SECRET=     # also seeds the owner passcodes generated for customers' Pro-site downloads (falls back to ADMIN_PASSWORD). Set it once and never change it.

# Where JSON data is stored (tickets, portfolio edits, stats). Must be a persistent, writable disk.
# DATA_DIR=/var/data/system-portfolio

# Mobile-money deposit instructions shown to customers on /track
MOMO_ACCOUNT_NAME=
MOMO_MTN_NUMBER=
MOMO_AIRTEL_NUMBER=

# Booking (all times Africa/Kampala). Defaults shown.
# BOOKING_DAYS=1,2,3,4,5,6        # 0=Sun … 6=Sat
# BOOKING_START=09:00
# BOOKING_END=18:00
# BOOKING_SLOT_MINUTES=60
# BOOKING_CAPACITY=2              # customers per slot
# BOOKING_LEAD_HOURS=2
# BOOKING_MAX_DAYS=30
# BOOKING_CLOSED_DATES=2026-12-25,2027-01-01

# Optional Cloudflare Turnstile bot check (set BOTH to enable)
# TURNSTILE_SECRET_KEY=

# ── Builder AI assistant (optional) ──
# With NO key the built-in assistant still handles simple commands ("make it green", "add a FAQ"). A key unlocks real AI:
# writing all your text, translating, redesigning, and reading uploaded images / PDF / Word / PowerPoint / text files.
# Use ONE of these (plain HTTPS calls — no extra npm package needed, so the unused @google/genai can stay or go):
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=            # + OPENAI_BASE_URL=https://api.groq.com/openai/v1  (any OpenAI-compatible service)
# AI_PROVIDER=anthropic      # only needed if you set several keys
# AI_MODEL=                  # override the default model (defaults: claude-sonnet-5-5 / gemini-2.5-flash / gpt-4o-mini)
# AI_DAILY_LIMIT=40          # AI requests per project per day (cost control)
# AI_GLOBAL_DAILY_LIMIT=600  # across all visitors per day

# ───────── Public (visible in the browser by design) ─────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_WHATSAPP=+256700000000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_HOURS=Mon–Sat, 8am–7pm
# Extra image hosts to optimize once you leave Unsplash (comma separated)
# NEXT_PUBLIC_IMAGE_HOSTS=res.cloudinary.com
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Cloud inbox (Pro sites send orders/bookings/enquiries to THIS server so owners see them on every device) ──
# Needs NEXT_PUBLIC_SITE_URL to be your public https address (customers' sites call it from their own domains).
# CLOUD_INBOX=off                 # master switch: stop accepting cloud traffic and stop baking it into new downloads
# CLOUD_SITE_HOURLY_LIMIT=400     # max submissions per shop per hour (flood / spam guard)
# CLOUD_MAX_PER_SITE=3000         # records kept per shop per type (orders, bookings, enquiries, subscribers); oldest are removed first

# ── Cloud chat model (optional; see /inference). Server-side only, visitors download nothing ──
# LLM_ENDPOINT=https://your-space.hf.space   # OpenAI-compatible server you host (llama.cpp / Ollama)
# LLM_MODEL=qwen2.5-instruct
# LLM_API_KEY=                               # only if your server needs a token
# LLM_LABEL=BALANCED
# LLM_MAX_TOKENS=400
# LLM_RATE_PER_MIN=12
# AI_FREE_DAILY=15          # free cloud-AI answers per visitor per day, then the chat uses its built-in rules
# AI_IP_DAILY_CAP=60        # per-IP daily cap (stops cookie-clearing refills)
# AI_TZ_HOURS=3             # day rolls over at midnight in this UTC offset (3 = Kampala)
# AI_ACCESS_SECRET=         # any long random string; signs the visitor cookie
